# Supabase (use the project URL only -- no /rest/v1/ path)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Google Maps (Geocoding + Places Text Search / Place Details for venues)
# Enable “Places API”, “Geocoding API” (and billing) in Google Cloud for car-club + event location search.
# Optional server-only key for /api/maps/* (falls back to NEXT_PUBLIC if unset).
GOOGLE_MAPS_API_KEY=your-server-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# App base URL — must match how you open the app. Supabase puts this in signup/reset links:
#   {NEXT_PUBLIC_APP_URL}/auth/callback?...
#
# If the link says localhost but you open it on another device (e.g. iPhone Mail), that device
# tries to reach ITS OWN localhost — connection fails. Open the link on the same machine running
# `npm run dev`, OR set NEXT_PUBLIC_APP_URL to your computer's LAN IP (e.g. http://192.168.1.12:3000),
# run Next with --hostname 0.0.0.0 if needed, and add that origin + /auth/callback in Supabase Auth
# redirect URLs; OR use an HTTPS tunnel (ngrok) and use that URL here + in Supabase.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase → Authentication → URL Configuration → Redirect URLs (examples):
#   http://localhost:3000/auth/callback
#   http://127.0.0.1:3000/auth/callback
#   http://YOUR_LAN_IP:3000/auth/callback
#   https://your-production-domain/auth/callback
# Password reset also uses /auth/callback?next=/reset-password/update — allowlist the same origins.

# Database (Prisma -- both required; no spaces before postgresql://; no quotes unless the whole value is quoted once)
# Supabase → Project Settings → Database: use "Transaction" URI for DATABASE_URL, "Session" or direct host :5432 for DIRECT_URL
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
