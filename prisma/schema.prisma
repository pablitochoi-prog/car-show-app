generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  USER
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum EventStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ACTIVE
  VOTING
  CLOSED
  ARCHIVED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum RegistrationFeeType {
  FREE
  PAID
  PAID_TIERED
  DONATION
}

enum StripeAccountStatus {
  NOT_CONNECTED
  ONBOARDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum PlatformFeeType {
  NONE
  FIXED
  PERCENT
}

enum EventPlatformFeeMode {
  CONVENIENCE
  FLAT_EVENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum MessageType {
  GENERAL
  REFUND_REQUEST
  SYSTEM
}

enum SmsProvider {
  TWILIO
  TELNYX
}

enum SmsNumberStatus {
  ACTIVE
  INACTIVE
}

enum SmsVoteSessionStatus {
  PENDING_CATEGORY
  COMPLETED
  EXPIRED
}

enum StepUpOtpPurpose {
  ORGANIZER_STEP_UP
}

enum StepUpAuditAction {
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  OTP_EXPIRED
  OTP_RATE_LIMITED
  ACCESS_DENIED
}

enum VehicleSaleInquiryStatus {
  NEW
  SENT_TO_OWNER
  FAILED_TO_SEND
  SPAM
  ARCHIVED
  CONTACTED
}

enum JudgingMethodology {
  DEDUCTION
  ADDITIVE
  ORIGINALITY_CONDITION
}

enum JudgingDeductionBucket {
  ORIGINALITY
  CONDITION
}

/// Subcategory scoring control (Phase 5A — UI: Full / Levels / Discretionary).
enum JudgingSubcategoryScoringType {
  FULL
  LEVELS
  DISCRETIONARY
}

/// Per-subcategory add/deduct override (Phase 5A); null inherits template methodology.
enum JudgingSubcategoryPointType {
  ADD
  DEDUCT
}

enum JudgeScoreSheetStatus {
  DRAFT
  SUBMITTED
  FINALIZED
}

enum EventJudgingTemplateEditLock {
  OPEN
  DRAFT_WARNING
  LOCKED
}

enum JudgeBallotCategoryStatus {
  DRAFT
  OPEN
  CLOSED
  FINALIZED
}

enum JudgeBallotAllocationStatus {
  ACTIVE
  SUBMITTED
  LOCKED
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String
  username    String?      @unique
  firstName   String?
  lastName    String?
  phone       String?
  /// SMS notification marketing/transactional opt-in (TCPA consent).
  smsNotificationsOptIn                 Boolean   @default(false)
  smsNotificationsOptInAt               DateTime?
  smsNotificationsOptInSource           String?
  smsNotificationsOptInPhone            String?
  smsNotificationsOptInIpAddress        String?
  smsNotificationsOptInUserAgent        String?
  smsNotificationsOptOutAt              DateTime?
  smsNotificationsConsentTextVersion    String?
  /// Street address line for profile / contact.
  street      String?
  city        String?
  /// US state postal abbreviation or region label.
  state       String?
  zip         String?
  /// Year of birth for profile (optional).
  birthYear   Int?
  avatarUrl   String?
  platformRole PlatformRole @default(USER)
  status       UserStatus   @default(ACTIVE)
  /// Admin note when status is changed (suspend, ban, etc.).
  statusReason String?
  statusChangedAt DateTime?
  /// Admin-hidden accounts are excluded from public listings.
  archivedAt  DateTime?
  /// Last authenticated activity for idle session enforcement.
  lastActivityAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Supabase Auth user id (links to auth.users)
  supabaseId  String       @unique

  orgMemberships OrganizationMember[]
  eventStaffMembers EventStaffMember[]
  vehicles       Vehicle[]
  vehiclePhotos  VehiclePhoto[]
  registrations  Registration[]
  publicVotes    VehiclePublicVote[]
  vehicleJudgeScores VehicleJudgeScore[] @relation("VehicleJudgeScores")
  sentMessages     Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  messageStates    MessageUserState[]
  stepUpOtpChallenges StepUpOtpChallenge[]
  stepUpAuditLogs     StepUpAuditLog[]
  vehicleSaleListings VehicleSaleListing[]
  vehicleSaleInquiries VehicleSaleInquiry[] @relation("VehicleSaleInquirySeller")
  judgeScoreSheets JudgeScoreSheet[] @relation("JudgeScoreSheets")
  judgeBallotCategoryAssignments JudgeBallotCategoryJudge[]
  judgeBallotAllocations JudgeBallotAllocation[]
  judgeBallotVotes JudgeBallotVote[]

  @@map("users")
}

model StepUpOtpChallenge {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      StepUpOtpPurpose
  codeHash     String
  expiresAt    DateTime
  attempts     Int              @default(0)
  maxAttempts  Int              @default(5)
  consumedAt   DateTime?
  lastSentAt   DateTime?
  emailSentAt  DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, purpose, consumedAt])
  @@map("step_up_otp_challenges")
}

model StepUpAuditLog {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  purpose   StepUpOtpPurpose
  action    StepUpAuditAction
  route     String?
  ip        String?
  userAgent String?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@map("step_up_audit_logs")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Short tagline shown on club profiles.
  motto String?
  /// Label for where the club usually meets (e.g. building or region).
  primaryMeetingLocation String?
  /// Free text, e.g. "First Tuesday monthly".
  meetingFrequency String?
  /// Typical meeting start time (24h HH:MM), same storage as event times.
  meetingTime String?
  /// Venue / place name for meetings.
  meetingVenueName String?
  street   String?
  city     String?
  state    String?
  zip      String?
  lat      Float?
  lng      Float?

  contactFirstName String?
  contactLastName  String?
  contactEmail     String?
  contactPhone     String?
  /// E.g. President, Treasurer — stored as plain text.
  contactRole      String?

  websiteUrl   String?
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  tikTokUrl    String?

  /// Listing visible / joinable by anyone vs restricted.
  openToPublic Boolean @default(true)
  /// Require a site member account to participate or join.
  requiresMemberAccount Boolean @default(false)
  yearFounded           Int?
  /// US state postal code where the club is based (club details; separate from meeting address state).
  clubState             String?
  /// Legacy optional timestamp (no longer collected on the car-club form; upcoming events are derived from linked Event rows).
  lastActivityAt DateTime?
  /// Owner-archived clubs are hidden from My clubs until restored.
  archivedAt DateTime?

  // ── Stripe Connect ──
  stripeAccountId        String?              @unique
  stripeAccountStatus    StripeAccountStatus  @default(NOT_CONNECTED)
  stripeChargesEnabled   Boolean              @default(false)
  stripePayoutsEnabled   Boolean              @default(false)
  stripeDetailsSubmitted Boolean              @default(false)
  onboardingCompletedAt  DateTime?
  stripeConnectedAt      DateTime?
  stripeLastSyncedAt     DateTime?

  members OrganizationMember[]
  events  Event[]
  messages Message[]

  @@map("organizations")
}

model OrganizationMember {
  id        String   @id @default(uuid())
  role      String   @default("member")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId])
  @@map("organization_members")
}

model Event {
  id           String      @id @default(uuid())
  name              String
  /// Unique numeric id for display as EVT-#### (assigned from 1001 at creation).
  showNumber        Int         @unique
  /// Unique 3-character code (A–Z, 2–9) for SMS voting / per-vehicle IDs, e.g. AXY-004.
  smsVotePrefix     String?     @unique
  /// Next 3-digit sequence number for this event (001–999). Incremented when vehicles are assigned IDs.
  nextVehicleNumber Int         @default(1)
  /// Organizer-facing estimate; optional.
  estimatedCarCount Int?
  description  String?
  venue        String?
  street       String?
  city         String?
  state        String?
  zip          String?
  lat          Float?
  lng          Float?
  startDate    DateTime
  endDate      DateTime?
  /// Optional backup date if weather postpones the show (calendar day, UTC noon storage).
  rainDate     DateTime?
  startTime    String?
  endTime      String?
  isMultiDay   Boolean     @default(false)
  flyerUrl     String?
  logoUrl      String?
  sponsorName            String?
  sponsorPrimaryContact  String?
  sponsorStreet          String?
  sponsorCity            String?
  sponsorState           String?
  sponsorZip             String?
  sponsorPhone           String?
  sponsorEmail           String?
  sponsorWebsite         String?
  sponsorLogoUrl         String?
  charityName            String?
  charityDescription     String?
  charityWebsite         String?
  charityEmail           String?
  charityPhone           String?
  charityLogoUrl         String?
  contactName      String?
  contactFirstName String?
  contactLastName  String?
  contactEmail String?
  contactPhone String?
  /// Public event page URL (https://…)
  eventWebsite  String?
  socialHashtag String?
  eventType    String      @default("car_show")
  status       EventStatus @default(DRAFT)
  listingScheduledAt     DateTime?
  registrationFeeType    RegistrationFeeType?
  registrationFeeDollars Float?
  dailyHours             Json?
  clonedFromId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // ── Payment settings ──
  paymentEnabled              Boolean              @default(false)
  platformFeeMode             EventPlatformFeeMode @default(CONVENIENCE)
  /// When true, the one-time flat event setup fee has been collected.
  platformSetupFeeCollected   Boolean              @default(false)
  platformFeeType             PlatformFeeType      @default(NONE)
  platformFeeAmountCents Int?
  platformFeePercent     Float?
  currency               String          @default("usd")

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  staffMembers      EventStaffMember[]
  roleDefinitions   EventRoleDefinition[]
  registrationTiers RegistrationTier[]
  registrations     Registration[]
  eventCategories   EventCategory[]
  eventAwards       EventAward[]
  votingCategories  VotingCategory[]
  smsVoteSessions   SmsVoteSession[]
  smsVotes          SmsVote[]
  messages          Message[]

  /// When true, attendees may vote via SMS using vehicle entry codes.
  smsVotingEnabled    Boolean   @default(false)
  smsVotingStartsAt   DateTime?
  smsVotingEndsAt     DateTime?
  /// When true, registrants may mark vehicles as accepting purchase inquiries.
  vehicleSaleInquiriesEnabled Boolean @default(false)

  vehicleSaleListings  VehicleSaleListing[]
  vehicleSaleInquiries VehicleSaleInquiry[]
  vehicleEntryIndexes  VehicleEntryIndex[]
  eventJudgingTemplates EventJudgingTemplate[]
  eventJudgingClasses   EventJudgingClass[]
  judgeScoreSheets      JudgeScoreSheet[]
  judgeBallotCategories JudgeBallotCategory[]
  judgeBallotAllocations JudgeBallotAllocation[]
  judgeBallotVotes      JudgeBallotVote[]
  @@index([status, startDate])
  @@index([city, state])
  @@index([orgId])
  @@map("events")
}

model RegistrationTier {
  id          String    @id @default(uuid())
  name        String
  priceCents  Int       @default(0)
  opensAt     DateTime?
  closesAt    DateTime?
  memberOnly  Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  registrations Registration[]

  @@index([eventId, sortOrder])
  @@map("registration_tiers")
}

enum VehiclePhotoStatus {
  PENDING
  READY
  FAILED
}

model Vehicle {
  id        String   @id @default(uuid())
  year      Int
  make      String
  model     String
  trim      String?
  /// Friendly name for the car (optional).
  nickname  String?
  /// Vehicle identification number (optional).
  vin       String?
  notes     String?
  photoUrl  String?
  /// Admin-hidden vehicles are excluded from public listings.
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  registrationRows RegistrationVehicle[]
  photos           VehiclePhoto[]

  @@index([userId])
  @@map("vehicles")
}

model VehiclePhoto {
  id               String             @id @default(uuid())
  userId           String
  vehicleId        String
  bucket           String
  objectKey        String             @unique
  visibility       String             @default("private")
  publicUrl        String?
  originalFilename String
  contentType      String
  sizeBytes        Int
  isPrimary        Boolean            @default(false)
  status           VehiclePhotoStatus @default(PENDING)
  createdAt        DateTime           @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@index([userId])
  @@map("vehicle_photos")
}

model Registration {
  id        String             @id @default(uuid())
  status    RegistrationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Null for guest registrations.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tierId String
  tier   RegistrationTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  // ── Payment tracking ──
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?        @unique
  paymentStatus           PaymentStatus?
  amountCents             Int?
  platformFeeCents        Int?
  /// Cumulative Stripe refund total in cents (partial refunds reduce displayed fees/collected).
  refundedCents           Int                @default(0)
  paidAt                  DateTime?
  /// Stripe event ID of the last processed webhook for idempotency.
  stripeEventId           String?

  /// Guest contact fields (null when userId is present).
  guestFirstName String?
  guestLastName  String?
  guestEmail     String?
  guestPhone     String?
  /// Logged-in registrant contact for this event (may differ from profile).
  registrantFirstName String?
  registrantLastName  String?
  registrantEmail     String?
  registrantPhone     String?
  registrantStreet    String?
  registrantCity      String?
  registrantState     String?
  registrantZip       String?
  /// Vehicle data for guests stored as JSON array of {year,make,model,trim,notes,nickname,...}.
  guestVehicles  Json?
  guestStreet    String?
  guestCity      String?
  guestState     String?
  guestZip       String?
  /// Snapshot of registrant profile photo for event staff (private R2 key).
  registrantPhotoObjectKey String?

  smsNotificationsOptIn                 Boolean   @default(false)
  smsNotificationsOptInAt               DateTime?
  smsNotificationsOptInSource           String?
  smsNotificationsOptInPhone            String?
  smsNotificationsOptInIpAddress        String?
  smsNotificationsOptInUserAgent        String?
  smsNotificationsOptOutAt              DateTime?
  smsNotificationsConsentTextVersion    String?

  vehicles RegistrationVehicle[]
  publicVotes  VehiclePublicVote[]
  judgeScores  VehicleJudgeScore[]
  judgeScoreSheets JudgeScoreSheet[]
  judgeBallotVotes JudgeBallotVote[]
  vehicleSaleListings VehicleSaleListing[]
  vehicleEntryIndexes VehicleEntryIndex[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([eventId, status])
  @@index([userId])
  @@index([eventId, guestEmail])
  @@map("registrations")
}

model RegistrationVehicle {
  id            String @id @default(uuid())
  /// Legacy optional display order; numeric part also matches the 3-digit suffix of publicVehicleId when set.
  displayNumber Int?
  /// Full display id for this vehicle at this event, e.g. AXY-004 (prefix unique per event; number unique among event vehicles).
  /// Also used as vehicleEntryCode for QR codes and SMS voting.
  publicVehicleId String? @unique
  /// Public R2 object key for the dash-card QR SVG.
  vehicleQrObjectKey String?
  /// Public URL for the dash-card QR SVG.
  vehicleQrUrl       String?
  /// Optional lifecycle label for public voting (e.g. OPEN, CLOSED).
  votingStatus       String?
  /// Optional lifecycle label for judging (e.g. OPEN, CLOSED).
  judgingStatus      String?

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  eventCategoryId String?
  eventCategory   EventCategory? @relation(fields: [eventCategoryId], references: [id], onDelete: SetNull)

  /// Event-specific nickname for dash cards and public pages (may differ from garage Vehicle.nickname).
  vehicleNickname String?
  /// Event-specific story/notes for dash cards and public pages (may differ from garage Vehicle.notes).
  vehicleStory    String? @db.Text

  eventPhotoObjectKey String?

  publicVotes   VehiclePublicVote[]
  judgeScores   VehicleJudgeScore[]
  judgeBallotVotes JudgeBallotVote[]
  judgeScoreSheets JudgeScoreSheet[]
  saleListing   VehicleSaleListing?
  vehicleEntryIndex VehicleEntryIndex?

  @@unique([registrationId, vehicleId])
  @@index([registrationId])
  @@map("registration_vehicles")
}

/// Indexed lookup by public vehicle / entry code (member RV rows and guest JSON vehicles).
enum VehicleEntryIndexType {
  REGISTRATION_VEHICLE
  GUEST_JSON
}

model VehicleEntryIndex {
  id                    String                @id @default(uuid())
  /// Canonical vehicle entry code (uppercase), e.g. AXY-004 — matches RegistrationVehicle.publicVehicleId.
  publicVehicleId       String                @unique
  eventId               String
  registrationId        String
  entryType             VehicleEntryIndexType
  registrationVehicleId String?               @unique
  /// Index in Registration.guestVehicles JSON when entryType is GUEST_JSON.
  guestVehicleIndex     Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  event               Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration        Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationVehicle RegistrationVehicle? @relation(fields: [registrationVehicleId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([registrationId])
  @@map("vehicle_entry_index")
}

/// Owner opt-in to receive buyer inquiries for a vehicle at a specific event.
model VehicleSaleListing {
  id                      String   @id @default(uuid())
  eventId                 String
  registrationId          String
  registrationVehicleId   String?  @unique
  guestVehicleIndex       Int?
  sellerUserId            String?
  enabled                 Boolean  @default(false)
  askingPriceCents        Int?
  showAskingPricePublicly Boolean  @default(false)
  allowOffers             Boolean  @default(false)
  minimumOfferCents       Int?
  description             String?  @db.Text
  sellerAcknowledgedAt    DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  event               Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration        Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationVehicle RegistrationVehicle? @relation(fields: [registrationVehicleId], references: [id], onDelete: Cascade)
  seller              User?                @relation(fields: [sellerUserId], references: [id], onDelete: SetNull)
  photos              VehicleSalePhoto[]
  inquiries           VehicleSaleInquiry[]

  @@unique([registrationId, guestVehicleIndex])
  @@index([eventId, enabled])
  @@index([sellerUserId])
  @@map("vehicle_sale_listings")
}

model VehicleSalePhoto {
  id               String   @id @default(uuid())
  listingId        String
  publicUrl        String
  objectKey        String   @unique
  sortOrder        Int      @default(0)
  originalFilename String?
  contentType      String?
  createdAt        DateTime @default(now())

  listing VehicleSaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("vehicle_sale_photos")
}

model VehicleSaleInquiry {
  id                      String                   @id @default(uuid())
  listingId               String
  eventId                 String
  sellerUserId            String?
  registrationVehicleId   String?
  guestVehicleIndex       Int?
  buyerName               String
  buyerEmail              String
  buyerPhone              String?
  offerAmountCents        Int?
  message                 String?                  @db.Text
  consentAt               DateTime
  smsNotificationsOptIn           Boolean                  @default(false)
  smsNotificationsOptInAt         DateTime?
  smsNotificationsOptInSource   String?
  smsNotificationsOptInPhone    String?
  smsNotificationsOptInIpAddress  String?
  smsNotificationsOptInUserAgent  String?
  smsNotificationsOptOutAt        DateTime?
  smsNotificationsConsentTextVersion String?
  status                  VehicleSaleInquiryStatus @default(NEW)
  ipHash                  String?
  userAgentHash           String?
  submittedAt             DateTime                 @default(now())
  notificationEmailSentAt DateTime?
  notificationSmsSentAt   DateTime?
  contactedAt             DateTime?

  listing VehicleSaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  event   Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seller  User?                @relation("VehicleSaleInquirySeller", fields: [sellerUserId], references: [id], onDelete: SetNull)

  @@index([listingId, submittedAt])
  @@index([sellerUserId, status])
  @@index([eventId])
  @@index([eventId, status])
  @@map("vehicle_sale_inquiries")
}

/// Web/QR public vote — one vote per visitor per category per event; at most one category per vehicle.
model VehiclePublicVote {
  id                    String   @id @default(uuid())
  eventId               String
  votingCategoryId      String
  vehicleEntryCode      String
  registrationId        String
  registrationVehicleId String?
  /// Event-scoped visitor id: hash(fingerprint + eventId).
  visitorKey            String
  userId                String?
  createdAt             DateTime @default(now())

  registration         Registration          @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationVehicle  RegistrationVehicle?  @relation(fields: [registrationVehicleId], references: [id], onDelete: SetNull)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  votingCategory       VotingCategory        @relation(fields: [votingCategoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, votingCategoryId, visitorKey])
  @@unique([eventId, vehicleEntryCode, visitorKey])
  @@index([eventId, vehicleEntryCode])
  @@map("vehicle_public_votes")
}

/// Judge score for a vehicle entry (one row per judge per entry).
model VehicleJudgeScore {
  id                    String   @id @default(uuid())
  eventId               String
  vehicleEntryCode      String
  registrationId        String
  registrationVehicleId String?
  judgeUserId           String
  score                 Int
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  registration         Registration          @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationVehicle  RegistrationVehicle?  @relation(fields: [registrationVehicleId], references: [id], onDelete: SetNull)
  judge                User                  @relation("VehicleJudgeScores", fields: [judgeUserId], references: [id], onDelete: Cascade)

  @@unique([eventId, vehicleEntryCode, judgeUserId])
  @@index([eventId, vehicleEntryCode])
  @@map("vehicle_judge_scores")
}

/// One membership row per user per event; roles are linked via EventStaffRoleLink.
model EventStaffMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleLinks EventStaffRoleLink[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_staff_members")
}

/// Event-specific role label (built-in defaults use stable slugs; customs use slug = null).
model EventRoleDefinition {
  id        String   @id @default(uuid())
  /// Stable key for default roles: organizer, treasurer, … — null for fully custom labels.
  slug      String?
  name      String
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  staffLinks EventStaffRoleLink[]

  @@unique([eventId, slug])
  @@unique([eventId, name])
  @@index([eventId])
  @@map("event_role_definitions")
}

model EventStaffRoleLink {
  staffMemberId String
  staffMember   EventStaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  roleId String
  role   EventRoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffMemberId, roleId])
  @@map("event_staff_role_links")
}

/// Folder that organises categories (e.g. "By Vehicle Year", "By Type").
model CategoryGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  categories Category[]

  @@map("category_groups")
}

/// Master list of registration/judging categories (managed by Site Admin).
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  /// true = shipped default or admin-created; false = event-level custom (not stored here).
  isSystem  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  groupId   String?
  group     CategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  eventCategories EventCategory[]

  @@index([groupId])
  @@map("categories")
}

/// Categories selected for a specific event, with trophy count.
model EventCategory {
  id          String  @id @default(uuid())
  /// Number of place awards for this category (e.g. 3 → 1st, 2nd, 3rd).
  trophyCount Int     @default(1)
  /// When using a custom one-off category not in the master list.
  customName  String?

  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  registrationVehicles RegistrationVehicle[]
  judgeBallotEligibleClasses JudgeBallotEligibleClass[]
  judgingClassEligible EventJudgingClassEligibleCategory?

  createdAt DateTime @default(now())

  @@unique([eventId, categoryId])
  @@index([eventId])
  @@map("event_categories")
}

/// Master list of special awards (managed by Site Admin).
model SpecialAward {
  id                 String   @id @default(uuid())
  name               String   @unique
  isSystem           Boolean  @default(true)
  sortOrder          Int      @default(0)
  /// When true, events may offer this award for public SMS / QR voting.
  smsVotingEligible  Boolean  @default(false)
  createdAt          DateTime @default(now())

  eventAwards EventAward[]

  @@map("special_awards")
}

/// Key-value store for site-wide admin settings (tier templates, staff roles, etc.).
model GlobalSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("global_settings")
}

/// Special/custom awards selected for a specific event.
model EventAward {
  id         String  @id @default(uuid())
  /// When using a custom one-off award not in the master list.
  customName String?

  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  specialAwardId String?
  specialAward   SpecialAward? @relation(fields: [specialAwardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([eventId, specialAwardId])
  @@index([eventId])
  @@map("event_awards")
}

model Message {
  id        String      @id @default(uuid())
  type      MessageType @default(GENERAL)
  subject   String
  body      String
  createdAt DateTime    @default(now())
  readAt    DateTime?

  senderUserId String
  sender       User   @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  recipientUserId String?
  recipient       User?  @relation("MessageRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  orgId String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  userStates MessageUserState[]

  @@index([recipientUserId])
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@index([senderUserId])
  @@index([eventId])
  @@map("messages")
}

/// Per-user inbox state (archive / delete) for a message thread.
model MessageUserState {
  id         String    @id @default(uuid())
  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@map("message_user_states")
}

/// Platform-shared inbound SMS number (all events use the same number).
model SmsNumber {
  id           String          @id @default(uuid())
  provider     SmsProvider     @default(TWILIO)
  phoneNumber  String          @unique
  status       SmsNumberStatus @default(ACTIVE)
  webhookUrl   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("sms_numbers")
}

/// SMS voting award category for an event (max 3 active; up to 1 custom).
model VotingCategory {
  id               String   @id @default(uuid())
  eventId          String
  name             String
  smsOptionNumber  Int
  isActive         Boolean  @default(true)
  isCustom         Boolean  @default(false)
  votingStartsAt   DateTime?
  votingEndsAt     DateTime?
  maxVotesPerPhone Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  smsVotes SmsVote[]
  publicVotes VehiclePublicVote[]

  @@unique([eventId, smsOptionNumber])
  @@index([eventId, isActive])
  @@map("voting_categories")
}

/// Pending multi-category SMS vote (expires after 10 minutes).
model SmsVoteSession {
  id                    String               @id @default(uuid())
  eventId               String
  vehicleEntryCode      String
  registrationId        String?
  registrationVehicleId String?
  fromPhoneHash         String
  provider              SmsProvider
  providerMessageId     String?
  status                SmsVoteSessionStatus @default(PENDING_CATEGORY)
  expiresAt             DateTime
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([fromPhoneHash, status, expiresAt])
  @@index([eventId, fromPhoneHash])
  @@map("sms_vote_sessions")
}

/// Recorded SMS vote (one per phone hash per category per event).
model SmsVote {
  id                    String      @id @default(uuid())
  eventId               String
  votingCategoryId      String
  vehicleEntryCode      String
  registrationId        String?
  registrationVehicleId String?
  fromPhoneHash         String
  provider              SmsProvider
  providerMessageId     String?
  rawBody               String
  normalizedVoteCode    String?
  createdAt             DateTime    @default(now())

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votingCategory VotingCategory @relation(fields: [votingCategoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, votingCategoryId, fromPhoneHash])
  @@index([eventId, vehicleEntryCode])
  @@index([provider, providerMessageId])
  @@map("sms_votes")
}

// ─── Structured score sheet judging (Phase 1A) ───────────────────────────────

/// Global master judging template (clone source only — never used for live scoring).
model JudgingTemplate {
  id           String               @id @default(uuid())
  slug         String               @unique
  name         String
  description  String?              @db.Text
  scoringGroup String?
  vehicleType  String?
  methodology  JudgingMethodology
  totalPoints  Int
  isActive     Boolean              @default(true)
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  sections     JudgingTemplateSection[]
  eventCopies  EventJudgingTemplate[]

  @@map("judging_templates")
}

model JudgingTemplateSection {
  id              String   @id @default(uuid())
  templateId      String
  name            String
  sortOrder       Int      @default(0)
  weightPercent   Float?
  maxSectionPoints Int?
  judgeGuidance   String?  @db.Text
  isActive        Boolean  @default(true)

  template JudgingTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    JudgingTemplateItem[]

  @@index([templateId, sortOrder])
  @@map("judging_template_sections")
}

model JudgingTemplateItem {
  id                         String   @id @default(uuid())
  sectionId                  String
  label                      String
  sortOrder                  Int      @default(0)
  maxPoints                  Int
  isIndented                 Boolean  @default(false)
  pointType                  JudgingSubcategoryPointType?
  scoringType                JudgingSubcategoryScoringType @default(LEVELS)
  allowMultipleViolations    Boolean  @default(false)
  judgeGuidance              String?  @db.Text
  requiresCommentOnDeduction Boolean  @default(false)
  isActive                   Boolean  @default(true)

  section          JudgingTemplateSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  deductionOptions JudgingTemplateDeductionOption[]

  @@index([sectionId, sortOrder])
  @@map("judging_template_items")
}

model JudgingTemplateDeductionOption {
  id               String                  @id @default(uuid())
  itemId           String
  label            String
  pointsDeducted   Int
  sortOrder        Int                     @default(0)
  deductionBucket  JudgingDeductionBucket?

  item JudgingTemplateItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
  @@map("judging_template_deduction_options")
}

/// Event-specific judging template (live rules — cloned from global or created from scratch).
model EventJudgingTemplate {
  id               String                       @id @default(uuid())
  eventId          String
  sourceTemplateId String?
  name             String
  description      String?                      @db.Text
  scoringGroup     String?
  vehicleType      String?
  methodology      JudgingMethodology
  totalPoints      Int
  editLock         EventJudgingTemplateEditLock @default(OPEN)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  event          Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceTemplate JudgingTemplate?         @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  sections       EventJudgingSection[]
  classes        EventJudgingClass[]
  scoreSheets    JudgeScoreSheet[]

  @@index([eventId])
  @@map("event_judging_templates")
}

model EventJudgingSection {
  id               String   @id @default(uuid())
  templateId       String
  name             String
  sortOrder        Int      @default(0)
  weightPercent    Float?
  maxSectionPoints Int?
  judgeGuidance    String?  @db.Text
  isActive         Boolean  @default(true)

  template EventJudgingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    EventJudgingItem[]

  @@index([templateId, sortOrder])
  @@map("event_judging_sections")
}

model EventJudgingItem {
  id                         String   @id @default(uuid())
  sectionId                  String
  label                      String
  sortOrder                  Int      @default(0)
  maxPoints                  Int
  isIndented                 Boolean  @default(false)
  pointType                  JudgingSubcategoryPointType?
  scoringType                JudgingSubcategoryScoringType @default(LEVELS)
  allowMultipleViolations    Boolean  @default(false)
  judgeGuidance              String?  @db.Text
  requiresCommentOnDeduction Boolean  @default(false)
  isActive                   Boolean  @default(true)

  section          EventJudgingSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  deductionOptions EventJudgingDeductionOption[]

  @@index([sectionId, sortOrder])
  @@map("event_judging_items")
}

model EventJudgingDeductionOption {
  id              String                  @id @default(uuid())
  itemId          String
  label           String
  pointsDeducted  Int
  sortOrder       Int                     @default(0)
  deductionBucket JudgingDeductionBucket?

  item EventJudgingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
  @@map("event_judging_deduction_options")
}

/// Structured judging class — maps vehicle classes to a score sheet template.
model EventJudgingClass {
  id                     String   @id @default(uuid())
  eventId                String
  name                   String
  description            String?  @db.Text
  eventJudgingTemplateId String
  isActive               Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  event              Event                               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template           EventJudgingTemplate                @relation(fields: [eventJudgingTemplateId], references: [id], onDelete: Cascade)
  eligibleCategories EventJudgingClassEligibleCategory[]
  scoreSheets        JudgeScoreSheet[]

  @@index([eventId, sortOrder])
  @@map("event_judging_classes")
}

/// Vehicle registration classes eligible for a structured judging class.
model EventJudgingClassEligibleCategory {
  id                  String @id @default(uuid())
  eventJudgingClassId String
  eventCategoryId     String @unique

  eventJudgingClass EventJudgingClass @relation(fields: [eventJudgingClassId], references: [id], onDelete: Cascade)
  eventCategory     EventCategory     @relation(fields: [eventCategoryId], references: [id], onDelete: Cascade)

  @@index([eventJudgingClassId])
  @@map("event_judging_class_eligible_categories")
}

/// Judge score sheet — snapshots event template structure when judging starts.
model JudgeScoreSheet {
  id                     String                @id @default(uuid())
  eventId                String
  eventJudgingTemplateId String
  eventJudgingClassId    String?
  vehicleEntryCode       String
  registrationId         String
  registrationVehicleId  String?
  judgeUserId            String
  status                 JudgeScoreSheetStatus @default(DRAFT)
  methodology            JudgingMethodology
  totalPoints            Int
  finalScore             Float?
  originalityDeductions  Int                   @default(0)
  conditionDeductions    Int                   @default(0)
  generalNotes           String?               @db.Text
  submittedAt            DateTime?
  finalizedAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  event                Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventJudgingTemplate EventJudgingTemplate @relation(fields: [eventJudgingTemplateId], references: [id], onDelete: Cascade)
  eventJudgingClass    EventJudgingClass?   @relation(fields: [eventJudgingClassId], references: [id], onDelete: SetNull)
  registration         Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationVehicle  RegistrationVehicle? @relation(fields: [registrationVehicleId], references: [id], onDelete: SetNull)
  judge                User                 @relation("JudgeScoreSheets", fields: [judgeUserId], references: [id], onDelete: Cascade)
  sections             JudgeScoreSheetSection[]

  @@unique([eventId, vehicleEntryCode, judgeUserId])
  @@index([eventId, eventJudgingTemplateId])
  @@map("judge_score_sheets")
}

model JudgeScoreSheetSection {
  id               String   @id @default(uuid())
  scoreSheetId     String
  name             String
  sortOrder        Int      @default(0)
  weightPercent    Float?
  maxSectionPoints Int?
  judgeGuidance    String?  @db.Text
  isActive         Boolean  @default(true)

  scoreSheet JudgeScoreSheet       @relation(fields: [scoreSheetId], references: [id], onDelete: Cascade)
  items      JudgeScoreSheetItem[]

  @@index([scoreSheetId, sortOrder])
  @@map("judge_score_sheet_sections")
}

model JudgeScoreSheetItem {
  id                         String   @id @default(uuid())
  sectionId                  String
  label                      String
  sortOrder                  Int      @default(0)
  maxPoints                  Int
  isIndented                 Boolean  @default(false)
  pointType                  JudgingSubcategoryPointType?
  scoringType                JudgingSubcategoryScoringType @default(LEVELS)
  allowMultipleViolations    Boolean  @default(false)
  judgeGuidance              String?  @db.Text
  requiresCommentOnDeduction Boolean  @default(false)
  isActive                   Boolean  @default(true)
  awardedPoints              Float?
  itemNotes                  String?  @db.Text

  section          JudgeScoreSheetSection              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  deductionOptions JudgeScoreSheetDeductionOption[]
  deductions       JudgeScoreSheetDeduction[]

  @@index([sectionId, sortOrder])
  @@map("judge_score_sheet_items")
}

model JudgeScoreSheetDeductionOption {
  id              String                  @id @default(uuid())
  itemId          String
  label           String
  pointsDeducted  Int
  sortOrder       Int                     @default(0)
  deductionBucket JudgingDeductionBucket?

  item JudgeScoreSheetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
  @@map("judge_score_sheet_deduction_options")
}

model JudgeScoreSheetDeduction {
  id                  String                  @id @default(uuid())
  itemId              String
  optionId            String?
  label               String
  pointsDeducted      Int
  violationCount      Int                     @default(1)
  discretionaryPoints Int?
  deductionBucket     JudgingDeductionBucket?
  comment             String?                 @db.Text

  item JudgeScoreSheetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("judge_score_sheet_deductions")
}

// ─── Assigned judge ballot voting (Phase 1B) ─────────────────────────────────

/// Judge-voted award category (Best Paint, Best in Show, etc.).
model JudgeBallotCategory {
  id                         String                    @id @default(uuid())
  eventId                    String
  name                       String
  description                String?                   @db.Text
  sortOrder                  Int                       @default(0)
  isActive                   Boolean                   @default(true)
  status                     JudgeBallotCategoryStatus @default(DRAFT)
  votesPerJudge              Int
  maxVotesPerJudgePerVehicle Int                       @default(1)
  startsAt                   DateTime?
  endsAt                     DateTime?
  showResultsToJudges        Boolean                   @default(false)
  judgeGuidance              String?                   @db.Text
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  event            Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eligibleClasses  JudgeBallotEligibleClass[]
  judgeAssignments JudgeBallotCategoryJudge[]
  allocations      JudgeBallotAllocation[]
  votes            JudgeBallotVote[]

  @@index([eventId, sortOrder])
  @@index([eventId, status])
  @@map("judge_ballot_categories")
}

/// Which registration vehicle classes may receive votes (empty = all classes).
model JudgeBallotEligibleClass {
  categoryId      String
  eventCategoryId String

  category      JudgeBallotCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  eventCategory EventCategory       @relation(fields: [eventCategoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, eventCategoryId])
  @@map("judge_ballot_eligible_classes")
}

/// Optional: restrict category to specific judges. Empty = all event judges.
model JudgeBallotCategoryJudge {
  categoryId  String
  judgeUserId String

  category JudgeBallotCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  judge    User                @relation(fields: [judgeUserId], references: [id], onDelete: Cascade)

  @@id([categoryId, judgeUserId])
  @@map("judge_ballot_category_judges")
}

/// Vote budget for one judge in one award category.
model JudgeBallotAllocation {
  id                  String                      @id @default(uuid())
  eventId             String
  categoryId          String
  judgeUserId         String
  totalVotesAllocated Int
  votesUsed           Int                         @default(0)
  status              JudgeBallotAllocationStatus @default(ACTIVE)
  submittedAt         DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  event    Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category JudgeBallotCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  judge    User                @relation(fields: [judgeUserId], references: [id], onDelete: Cascade)

  @@unique([categoryId, judgeUserId])
  @@index([eventId, judgeUserId])
  @@map("judge_ballot_allocations")
}

/// One row per judge × award category × vehicle; voteCount may be > 1.
model JudgeBallotVote {
  id                    String   @id @default(uuid())
  eventId               String
  categoryId            String
  judgeUserId           String
  registrationId        String
  registrationVehicleId String?
  vehicleEntryCode      String
  voteCount             Int
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category            JudgeBallotCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  judge               User                @relation(fields: [judgeUserId], references: [id], onDelete: Cascade)
  registration        Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationVehicle RegistrationVehicle? @relation(fields: [registrationVehicleId], references: [id], onDelete: SetNull)

  @@unique([categoryId, judgeUserId, vehicleEntryCode])
  @@index([categoryId, vehicleEntryCode])
  @@index([eventId, categoryId])
  @@map("judge_ballot_votes")
}
